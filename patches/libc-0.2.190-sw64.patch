+//! Header: `sysdeps/unix/sysv/linux/sw64/bits/signum-arch.h`
+//!
+//! sw64（alpha 系 ABI）信号编号与 generic 差异大，值按目标机实测（与
+//! legacy sw64.rs 同源）。sw64 无 SIGSTKFLT，不定义。
+
+use crate::prelude::*;
+
+pub const SIGPWR: c_int = 29;
+pub const SIGBUS: c_int = 10;
+pub const SIGSYS: c_int = 12;
+pub const SIGURG: c_int = 16;
